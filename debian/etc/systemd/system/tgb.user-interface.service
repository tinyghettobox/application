[Unit]
Description=TinyGhettoBox user interface
Wants=local-fs.target systemd-timesyncd.service pulseaudio.service
After=local-fs.target systemd-timesyncd.service pulseaudio.service

[Service]
WorkingDirectory=/srv/tinyghettobox
Environment="DISPLAY=:0"
ExecStart=/srv/tinyghettobox/user_interface
Restart=always
RestartSec=20
Type=simple
User=tinyghettobox

[Install]
WantedBy=local-fs.target
