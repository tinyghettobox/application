import { VerticalBox, ScrollView } from "std-widgets.slint";
import { Theme } from "./theme.slint";

export struct UILogEntry {
    level: string,  // "error" | "warn" | "info" | "debug"
    message: string,
    timestamp: string,
}

export global Logs {
    in property <bool> visible: false;
    in property <[UILogEntry]> entries: [];
    in property <string> filter-level: "info";  // "error" | "warn" | "info" | "debug"
    callback close();
    callback set-filter(string);
}

export component LogsView {
    visible: Logs.visible;
    width: 100%;
    height: 100%;
    z: 100;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.background-color;

        VerticalBox {
            padding: 0;
            spacing: 0;

            // Header bar
            Rectangle {
                height: 56px;
                background: Theme.background-accent-color;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 8px;
                    spacing: 8px;

                    Text {
                        text: "Logs";
                        color: Theme.text-color;
                        font-size: 20px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    // Level filter buttons
                    for level-item in ["error", "warn", "info", "debug"]: Rectangle {
                        width: 64px;
                        height: 40px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: Logs.filter-level == level-item
                            ? Theme.primary-color
                            : Theme.background-color;
                        border-width: 1px;
                        border-color: Theme.border-color;
                        filter-touch := TouchArea {
                            clicked => { Logs.set-filter(level-item); }
                        }
                        Text {
                            text: level-item;
                            color: Theme.text-color;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Close button
                    close-area := TouchArea {
                        width: 56px;
                        height: 56px;
                        clicked => { Logs.close(); }
                        Text {
                            text: "✕";
                            color: Theme.text-color;
                            font-size: 22px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle {
                    width: parent.width;
                    height: 1px;
                    y: parent.height - self.height;
                    background: Theme.border-color;
                }
            }

            // Log list
            ScrollView {
                vertical-stretch: 1;
                viewport-width: parent.width;

                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;
                    width: parent.width;

                    for entry in Logs.entries: Rectangle {
                        visible: entry.level == "error"
                            || (entry.level == "warn" && (Logs.filter-level == "warn" || Logs.filter-level == "info" || Logs.filter-level == "debug"))
                            || (entry.level == "info" && (Logs.filter-level == "info" || Logs.filter-level == "debug"))
                            || (entry.level == "debug" && Logs.filter-level == "debug");
                        height: self.visible ? log-text.preferred-height + 12px : 0px;
                        background: transparent;

                        HorizontalLayout {
                            padding: 4px;
                            spacing: 8px;

                            // Level badge
                            Rectangle {
                                width: 52px;
                                height: log-text.preferred-height;
                                border-radius: 3px;
                                background: entry.level == "error" ? #cc2222
                                    : entry.level == "warn" ? #cc7700
                                    : entry.level == "info" ? #226688
                                    : #444444;
                                Text {
                                    text: entry.level;
                                    color: #ffffff;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // Timestamp
                            Text {
                                text: entry.timestamp;
                                color: Theme.text-accent-color;
                                font-size: 13px;
                                vertical-alignment: center;
                                width: 90px;
                            }

                            // Message
                            log-text := Text {
                                text: entry.message;
                                color: Theme.text-color;
                                font-size: 14px;
                                vertical-alignment: center;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }
        }
    }
}
