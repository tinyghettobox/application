
import { VerticalBox, ScrollView } from "std-widgets.slint";
import { Theme } from "./theme.slint";
import { UILibraryEntry, Helper } from "./common.slint";
import { IconPlay, IconCheck } from "./icons.slint";

export component ListItem {
    in property <int> list_index;
    in property <int> id;
    in property <int> parent_id;
    in property <string> variant;
    in property <string> name;
    in property <string> played_at;
    in property <[int]> image;
    in property <int> sort_key;
    in property <bool> is_loaded: false;
    in property <bool> is_playing: false;
    callback clicked(int /* id */);
    callback long-pressed(int /* id */, string /* name */);

    property <color> accent-color: is_playing ? Theme.secondary-color : Theme.primary-color;
    property <bool> aurora-tick: false;
    property <bool> press-active: false;
    property <bool> long-press-consumed: false;

    // Two-state toggle drives a continuous left-to-right drift.
    // The band is 3× the row width so one full cycle shifts by exactly 1× width,
    // making the loop seamless: end position of tick=true == start of next tick=false pass.
    Timer {
        interval: Theme.aurora-duration;
        running: is_loaded;
        triggered => { aurora-tick = !aurora-tick; }
    }

    Timer {
        interval: 3000ms;
        running: press-active;
        triggered => {
            press-active = false;
            long-press-consumed = true;
            root.long-pressed(root.id, root.name);
        }
    }

    property <length> aurora-width: root.width * 3;
    property <length> aurora-x: aurora-tick ? -root.width * 2 : -root.width;
    animate aurora-x { duration: Theme.aurora-duration; easing: linear; }

    min-height: 48px;
    preferred-height: 48px;

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            if !root.long-press-consumed {
                root.clicked(root.id);
            }
            root.long-press-consumed = false;
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.press-active = true;
                root.long-press-consumed = false;
            } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                root.press-active = false;
            }
        }
    }

    // Aurora sweep — full-color gradient band drifting slowly left to right
    Rectangle {
        x: aurora-x;
        y: 0;
        width: aurora-width;
        height: parent.height;
        opacity: is_loaded ? Theme.aurora-opacity : 0.0;
        background: @linear-gradient(90deg,
            Theme.aurora-color-1 0%,
            Theme.aurora-color-2 17%,
            Theme.aurora-color-3 33%,
            Theme.aurora-color-4 50%,
            Theme.aurora-color-5 67%,
            Theme.aurora-color-1 83%,
            Theme.aurora-color-2 100%
        );
        animate opacity { duration: 600ms; easing: ease-out; }
    }

    HorizontalLayout {
        x: 0;
        width: parent.width;
        height: parent.height;
        padding: 8px;
        spacing: 10px;

        Rectangle {
            width: 40px;
            if is_playing: IconPlay {
                color: is_loaded ? accent-color : Theme.text-accent-color;
                width: 14px;
                height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                animate color { duration: 400ms; easing: ease-out; }
            }
            if !is_playing: Text {
                text: "#" + list_index;
                width: parent.width;
                height: parent.height;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
                color: Theme.text-accent-color;
            }
        }

        Text {
            text: name;
            font-size: 16px;
            vertical-alignment: center;
            horizontal-alignment: left;
            color: is_loaded ? (is_playing ? accent-color : Theme.text-color) : Theme.text-color;
            animate color { duration: 400ms; easing: ease-out; }
        }

        if played_at != "" && !is_playing: Rectangle {
            width: 32px;
            IconCheck {
                color: Theme.text-accent-color;
                width: 16px;
                height: 16px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
    }
}

export component DetailListView {
    in property <[UILibraryEntry]> rows: [];
    callback entry-clicked(int /* id */);
    callback entry-long-pressed(int /* id */, string /* name */);

    width: 100%;
    height: 100%;
    ScrollView {
        VerticalBox {
            alignment: start;
            for entry[index] in rows: ListItem {
                list_index: index + 1;
                id: entry.id;
                parent_id: entry.parent_id;
                variant: entry.variant;
                name: entry.name;
                played_at: entry.played_at;
                image: entry.image;
                sort_key: entry.sort_key;
                is_loaded: entry.is_loaded;
                is_playing: entry.is_playing;
                clicked => { entry-clicked(entry.id); }
                long-pressed(id, name) => { entry-long-pressed(id, name); }
            }
        }
    }
}
