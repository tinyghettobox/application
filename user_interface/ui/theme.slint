export global Theme {
    in property <brush> background-color: #121212;
    in property <brush> background-accent-color: #1f1f1f;
    in property <brush> text-color: #ffffff;
    in property <brush> text-accent-color: #bbbbbb;
    in property <brush> primary-color: #6200ee;
    in property <brush> secondary-color: #d9fdf9;
    in property <brush> border-color: #2e2e2e;

    // Aurora animation — active highlight on tiles and list rows
    in property <color> aurora-color-1: #00c896;
    in property <color> aurora-color-2: #0077ff;
    in property <color> aurora-color-3: #9b30ff;
    in property <color> aurora-color-4: #ff3366;
    in property <color> aurora-color-5: #ff9900;
    in property <duration> aurora-duration: 2000ms;
    in property <float> aurora-opacity: 0.4;
    in property <length> aurora-tile-border-width: 5px;
}
