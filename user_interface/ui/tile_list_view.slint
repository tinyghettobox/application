import { VerticalBox, HorizontalBox, ScrollView } from "std-widgets.slint";
import { Theme } from "./theme.slint";
import { UILibraryEntry, Helper } from "./common.slint";

export component Tile {
    in property <int> id;
    in property <int> parent_id;
    in property <string> variant;
    in property <string> name;
    in property <string> played_at;
    in property <[int]> image;
    in property <int> sort_key;
    in property <bool> is_loaded: false;
    in property <bool> is_playing: false;
    in property <int> play_progress: 0;
    in property <float> progress_arc_x: 90;
    in property <float> progress_arc_y: 0;

    callback clicked(int /* id */);
    callback long-pressed(int /* id */, string /* name */);
    callback play-clicked(int /* id */);

    property <bool> aurora-tick: false;
    property <bool> press-active: false;
    property <bool> long-press-consumed: false;

    Timer {
        interval: Theme.aurora-duration;
        running: is_loaded;
        triggered => { aurora-tick = !aurora-tick; }
    }

    Timer {
        interval: 3000ms;
        running: press-active;
        triggered => {
            press-active = false;
            long-press-consumed = true;
            root.long-pressed(root.id, root.name);
        }
    }

    property <length> ring-size: 180px;
    property <length> aurora-band-width: ring-size * 3;
    property <length> aurora-x: aurora-tick ? -ring-size * 2 : -ring-size;
    animate aurora-x { duration: Theme.aurora-duration; easing: linear; }

    TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            if !root.long-press-consumed {
                root.clicked(root.id);
            }
            root.long-press-consumed = false;
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.press-active = true;
                root.long-press-consumed = false;
            } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                root.press-active = false;
            }
        }
    }

    VerticalBox {
        spacing: 10px;

        // Outer ring — clips the aurora gradient to a circle
        Rectangle {
            width: ring-size;
            height: ring-size;
            border-radius: ring-size / 2;
            clip: true;

            // Dark base fill so inactive state looks clean
            Rectangle {
                width: parent.width;
                height: parent.height;
                background: Theme.background-accent-color;
            }

            // Aurora gradient band sweeping left to right behind the image
            Rectangle {
                x: aurora-x;
                y: 0;
                width: aurora-band-width;
                height: parent.height;
                opacity: is_loaded ? 1.0 : 0.0;
                background: @linear-gradient(90deg,
                    Theme.aurora-color-1 0%,
                    Theme.aurora-color-2 17%,
                    Theme.aurora-color-3 33%,
                    Theme.aurora-color-4 50%,
                    Theme.aurora-color-5 67%,
                    Theme.aurora-color-1 83%,
                    Theme.aurora-color-2 100%
                );
                animate opacity { duration: 600ms; easing: ease-out; }
            }

            // Image circle inset by aurora-tile-border-width to expose the colored ring
            Rectangle {
                x: Theme.aurora-tile-border-width;
                y: Theme.aurora-tile-border-width;
                width: ring-size - Theme.aurora-tile-border-width * 2;
                height: ring-size - Theme.aurora-tile-border-width * 2;
                border-radius: (ring-size - Theme.aurora-tile-border-width * 2) / 2;
                clip: true;

                if image.length == 0: Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: @linear-gradient(135deg, #3a1c71, #6200ee, #03dac6);

                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: name;
                        font-size: 28px;
                        font-weight: 700;
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                        wrap: word-wrap;
                    }
                }

                if image.length > 0: Image {
                    source: Helper.get_image(image);
                    width: parent.width;
                    height: parent.height;
                    image-fit: cover;
                }
            }

            // Circular progress arc drawn over the ring border, only for folders with progress and not during playback
            if play_progress > 0 && play_progress < 100 && variant == "folder" && !is_loaded: Path {
                x: 0;
                y: 0;
                width: ring-size;
                height: ring-size;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: 180;
                viewbox-height: 180;
                stroke: Theme.secondary-color;
                stroke-width: Theme.aurora-tile-border-width;
                fill: transparent;
                MoveTo { x: 90; y: 0; }
                ArcTo {
                    radius-x: 90;
                    radius-y: 90;
                    x: progress_arc_x;
                    y: progress_arc_y;
                    sweep: true;
                    large-arc: play_progress > 50;
                }
            }

            // Full circle highlight for 100% played folders, hidden during playback
            if play_progress >= 100 && variant == "folder" && !is_loaded: Rectangle {
                x: 0;
                y: 0;
                width: ring-size;
                height: ring-size;
                border-radius: ring-size / 2;
                border-width: Theme.aurora-tile-border-width;
                border-color: Theme.secondary-color;
                background: transparent;
            }

        }

        Text {
            text: name;
            font-size: 16px;
            color: Theme.text-color;
            horizontal-alignment: center;
            wrap: word-wrap;
            overflow: clip;
            height: 58px; // fixed height for up to 3 lines, keeps all tiles in a row equal
        }
    }

    // ▶ play badge — after VerticalBox so it renders on top, outside the clipped ring
    if variant == "folder": Rectangle {
        property <length> badge-size: 56px;
        x: ring-size - badge-size - 4px;
        y: ring-size - badge-size - 4px;
        width: badge-size;
        height: badge-size;
        border-radius: badge-size / 2;
        background: Theme.primary-color;

        Text {
            width: parent.width;
            height: parent.height;
            text: "▶";
            font-size: 22px;
            color: Theme.text-color;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => { root.play-clicked(root.id); }
        }
    }
}

export component TileListView {
    // Data: Rust passes only the visible window of rows; Slint renders ~12 at most.
    in property <[[UILibraryEntry]]> rows;
    in property <int> total-row-count: 0;  // total rows across all entries — drives viewport height
    in property <int> first-row: 0;        // row index of rows[0] within the full list

    callback entry-clicked(int /* id */);
    callback entry-long-pressed(int /* id */, string /* name */);
    callback entry-play-clicked(int /* id */);
    callback report-scroll-y(float /* viewport-y in logical pixels */);

    // Scroll restore — seq is always incremented so `changed` fires even when y value is the same
    in property <float> restore-scroll-y: 0;
    in property <int>   restore-scroll-seq: 0;

    width: 100%;
    height: 100%;

    // Row height: MUST match ROW_HEIGHT_PX in content.rs
    // Tile VerticalBox: padding(8+8) + ring(180) + spacing(10) + text(58) = 264px, + row-gap(8) = 272px
    property <length> row-height: 272px;

    // Deferred scroll restore: fires on component creation (scroll-restore-pending starts true)
    // AND on each navigation (changed restore-scroll-seq sets it true).
    // The 1-tick delay lets Slint commit the viewport-height binding before setting viewport-y,
    // and also handles the tile→detail→tile case where TileListView is recreated from scratch
    // (changed doesn't fire for initial property values, but the timer always fires on creation).
    property <bool> scroll-restore-pending: true;
    Timer {
        interval: 16ms;
        running: root.scroll-restore-pending;
        triggered => {
            root.scroll-restore-pending = false;
            scroll-area.viewport-y = root.restore-scroll-y * 1px;
        }
    }
    changed restore-scroll-seq => { root.scroll-restore-pending = true; }

    VerticalBox {
        scroll-area := ScrollView {
            // Virtual viewport: full logical height even though only ~12 rows are rendered
            viewport-height: root.total-row-count * root.row-height;

            changed viewport-y => {
                root.report-scroll-y(self.viewport-y / 1px);
            }

            // Non-layout container so rows can be absolutely positioned by their virtual y offset
            Rectangle {
                width: scroll-area.visible-width;
                height: scroll-area.viewport-height;

                for row[i] in rows: HorizontalBox {
                    y: (root.first-row + i) * root.row-height;
                    x: 0;
                    width: parent.width;
                    alignment: center;
                    spacing: 20px;
                    for entry in row: Tile {
                        id: entry.id;
                        parent_id: entry.parent_id;
                        variant: entry.variant;
                        name: entry.name;
                        played_at: entry.played_at;
                        image: entry.image;
                        sort_key: entry.sort_key;
                        is_loaded: entry.is_loaded;
                        is_playing: entry.is_playing;
                        play_progress: entry.play_progress;
                        progress_arc_x: entry.progress_arc_x;
                        progress_arc_y: entry.progress_arc_y;
                        clicked => { entry-clicked(entry.id); }
                        long-pressed(id, name) => { entry-long-pressed(id, name); }
                        play-clicked => { entry-play-clicked(entry.id); }
                    }
                }
            }
        }
    }

    // Scrollbar overlay — only shown when content is taller than the visible area
    if scroll-area.viewport-height > scroll-area.visible-height + 4px: Rectangle {
        x: root.width - 14px;
        y: 0;
        width: 14px;
        height: root.height;
        background: transparent;

        property <length> scrollable-height: scroll-area.viewport-height - scroll-area.visible-height;
        property <length> thumb-height: max(44px, root.height * (scroll-area.visible-height / max(1px, scroll-area.viewport-height)));
        property <length> track-height: root.height - thumb-height;
        property <float> scroll-progress: scrollable-height > 0px
            ? (-scroll-area.viewport-y / scrollable-height)
            : 0;
        property <length> thumb-y: track-height * scroll-progress;

        // Track
        Rectangle {
            x: 5px;
            y: 0;
            width: 4px;
            height: parent.height;
            border-radius: 2px;
            background: Theme.background-accent-color;
        }

        // Thumb
        Rectangle {
            x: 3px;
            y: thumb-y;
            width: 8px;
            height: thumb-height;
            border-radius: 4px;
            opacity: 0.75;
            background: Theme.secondary-color;
        }

        // Touch target for drag-scrolling
        TouchArea {
            width: parent.width;
            height: parent.height;
            property <length> drag-start-mouse-y: 0;
            property <length> drag-start-viewport-y: 0;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    self.drag-start-mouse-y = self.mouse-y;
                    self.drag-start-viewport-y = scroll-area.viewport-y;
                }
            }
            moved => {
                scroll-area.viewport-y = max(
                    -parent.scrollable-height,
                    min(0px,
                        self.drag-start-viewport-y
                        - ((self.mouse-y - self.drag-start-mouse-y) / max(1px, parent.track-height))
                          * parent.scrollable-height
                    )
                );
            }
        }
    }
}
